[package]
name = "vani"
version = "${file:VERSION}"
description = "vani — audio device I/O for Cyrius. The voice of the system."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/vani"
language = "cyrius"
cyrius = "6.5.32"

# vani is a library — no CLI binary. This entry exists so `cyrius build`
# has a target that links the full include chain.
[build]
entry = "programs/smoke.cyr"
output = "build/vani_smoke"

# Feeds `cyrius distlib` → dist/vani.cyr. Order is dependency order and
# must not be rearranged. Stdlib includes live in src/lib.cyr, not here.
# Module roles: docs/architecture/overview.md
[lib]
modules = [
    "src/alsa.cyr",
    "src/error.cyr",
    "src/format.cyr",
    "src/buffer.cyr",
    "src/device.cyr",
    "src/playback.cyr",
    "src/capture.cyr",
    "src/mixer.cyr",
]

# Playback-only subset → `cyrius distlib core` → dist/vani-core.cyr.
# Single module by construction: src/alsa.cyr has no cross-module
# references. Rationale and consumers: docs/architecture/overview.md
[lib.core]
modules = [
    "src/alsa.cyr",
]

# Resolved into lib/ by `cyrius deps`. lib/ is gitignored — a build
# artifact, never edited by hand. Note `cyrius build` resolves
# `include "lib/…"` from the version-pinned toolchain snapshot, not
# from ./lib — see docs/architecture/overview.md.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "fs",
    "args",
    "hashmap",
    "tagged",
    "fnptr",
    "freelist",
    "process",
    "chrono",
    "sakshi",
    "yukti",
    "patra",
    "atomic",
    "sync",
    "thread_local",
]

